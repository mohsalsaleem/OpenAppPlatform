        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "description": "Requires an attention state and its current updatedAt. Never reissues an uncertain deployment. Missing provider IDs must be identified by the owner; resource association is verified. Unfinished instances resume once all attention steps are resolved.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Recovery"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "Component": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "web"
            ]
          },
          "image": {
            "type": "string"
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "instances": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4,
            "default": 1
          },
          "strategy": {
            "type": "string",
            "enum": [
              "standard"
            ],
            "default": "standard"
          },
          "resourceId": {
            "type": "string"
          },
          "hostPort": {
            "oneOf": [
              {
                "type": "integer",
                "enum": [
                  0
                ]
              },
              {
                "type": "integer",
                "minimum": 1024,
                "maximum": 65535
              }
            ],
            "description": "Zero keeps a component private. A fixed host port requires one instance."
          }
        },
        "required": [
          "name",
          "image",
          "port"
        ],
        "additionalProperties": false
      },
      "Manifest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          },
          "targetId": {
            "type": "string"
          },
          "components": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "$ref": "#/components/schemas/Component"
            }
          }
        },
        "required": [
          "name",
          "environment",
          "targetId",
          "components"
        ],
        "additionalProperties": false
      },
      "Application": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "manifest": {
            "$ref": "#/components/schemas/Manifest"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "manifest",
          "createdAt",
          "version",
          "updatedAt"
        ],
        "additionalProperties": false
      },
      "Target": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "operator": {
            "type": "string",
            "enum": [
              "coolify",
              "docker"
            ]
          },
          "url": {
            "type": "string"
          },
          "projectId": {
            "type": "string"
          },
          "serverId": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          },
          "settings": {
            "type": "object",
            "properties": {
              "pullPolicy": {
                "type": "string",
                "enum": [
                  "never",
                  "if-missing"
                ]
              },
              "hostBindIP": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "operator",
          "url",
          "projectId",
          "serverId",
          "environment"
        ],
        "additionalProperties": false
      },
      "Resource": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          },
          "projectId": {
            "type": "string"
          },
          "artifactKind": {
            "type": "string",
            "enum": [
              "image",
              "source"
            ]
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "required": [
          "id",
          "name",
          "status"
        ],
        "additionalProperties": false
      },
      "Step": {
        "type": "object",
        "properties": {
          "component": {
            "type": "string"
          },
          "ordinal": {
            "type": "integer"
          },
          "phase": {
            "type": "string",
            "enum": [
              "pending",
              "prepared",
              "dispatching",
              "observing",
              "succeeded",
              "failed",
              "attention"
            ]
          },
          "resourceId": {
            "type": "string"
          },
          "remoteDeploymentId": {
            "type": "string"
          },
          "observed": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "recoveryPhase": {
            "type": "string"
          },
          "observationStartedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "component",
          "ordinal",
          "phase"
        ],
        "additionalProperties": false
      },
      "Deployment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "applicationId": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "attention"
            ]
          },
          "manifest": {
            "$ref": "#/components/schemas/Manifest"
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Step"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "definitionVersion": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "id",
          "applicationId",
          "state",
          "manifest",
          "steps",
          "createdAt",
          "updatedAt",
          "definitionVersion"
        ],
        "additionalProperties": false
      },
      "Instance": {
        "type": "object",
        "required": [
          "component",
          "ordinal",
          "status",
          "checkedAt"
        ],
        "additionalProperties": false,
        "properties": {
          "component": {
            "type": "string"
          },
          "ordinal": {
            "type": "integer",
            "minimum": 1
          },
          "resourceId": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "resource": {
            "$ref": "#/components/schemas/Resource"
          },
          "error": {
            "type": "string"
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Recovery": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component",
          "ordinal",
          "expectedUpdatedAt"
        ],
        "properties": {
          "component": {
            "type": "string"
          },
          "ordinal": {
            "type": "integer",
            "minimum": 1
          },
          "expectedUpdatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "remoteDeploymentId": {
            "type": "string",
            "maxLength": 256
          },
          "retryPreparation": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
