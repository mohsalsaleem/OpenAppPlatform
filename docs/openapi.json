              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "images": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string",
                      "pattern": "@sha256:[a-f0-9]{64}$"
                    }
                  },
                  "expectedVersion": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "If positive, reject a new release when this definition version has changed."
                  }
                },
                "required": [],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
