DATABASE_URL=postgres://oap:oap-local@127.0.0.1:55438/oap?sslmode=disable
OAP_ADDR=127.0.0.1:8787
OAP_AUTH_MODE=owner
OAP_SETUP_TOKEN=replace-with-at-least-24-random-characters
# Local HTTP only; hosted installations must retain secure cookies.
OAP_COOKIE_SECURE=false
# OAP_API_TOKEN is used only by scoped MCP clients or isolated preview fixtures.
COOLIFY_TOKEN=replace-with-your-coolify-api-token
# Used only by opt-in real Coolify integration tests:
COOLIFY_URL=https://coolify.example.com
COOLIFY_PROJECT_ID=replace-with-dedicated-test-project
COOLIFY_SERVER_ID=replace-with-server
COOLIFY_ENVIRONMENT=staging
COOLIFY_TEST_IMAGE=nginx@sha256:replace-with-resolved-image-digest
