{
  "apiVersion": "oap.dev/v1alpha1",
  "kind": "Application",
  "spec": {
    "name": "topology-example",
    "targetId": "docker-local",
    "environment": "staging",
    "components": [
      {
        "name": "web",
        "kind": "web",
        "image": "example/web:replace-with-immutable-image",
        "port": 8080,
        "hostPort": 8080,
        "instances": 1
      },
      {
        "name": "worker",
        "kind": "worker",
        "image": "example/worker:replace-with-immutable-image",
        "instances": 1
      }
    ]
  }
}
